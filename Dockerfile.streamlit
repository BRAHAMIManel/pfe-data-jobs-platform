# Image de base figee par empreinte (voir docker-compose.yml).
FROM python:3.11-slim@sha256:d0d43a8b0c352c215cd1381f3f4d7ac34cf3440cd0415873451d7affca53a769

# Les versions sont dans app/requirements.txt : un seul endroit a
# mettre a jour, et c'est ce fichier que la CI audite (pip-audit).
COPY app/requirements.txt /tmp/requirements-app.txt
RUN pip install --no-cache-dir -r /tmp/requirements-app.txt

# Securite : l'application ne tourne pas en root. Si elle etait
# compromise, l'attaquant n'aurait que les droits de ce compte, sans
# pouvoir modifier le systeme du conteneur.
RUN useradd --create-home --uid 10001 appli

WORKDIR /app

# Les modules partages avec Airflow (transformation, cv) sont montes
# dans /scripts par docker-compose.
ENV PYTHONPATH=/scripts

USER appli

CMD ["streamlit", "run", "app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501", \
     "--server.headless=true"]