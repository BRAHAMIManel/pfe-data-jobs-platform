FROM python:3.11-slim

RUN pip install --no-cache-dir \
    streamlit==1.45.1 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.2 \
    pdfplumber==0.11.4 \
    python-docx==1.1.2

WORKDIR /app

# Les modules partages avec Airflow (transformation, cv) sont montes
# dans /scripts par docker-compose.
ENV PYTHONPATH=/scripts

CMD ["streamlit", "run", "app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501", \
     "--server.headless=true"]
