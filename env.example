# Modele du fichier .env : copier en .env puis remplacer chaque valeur.
# Le vrai .env n'est JAMAIS pousse sur GitHub (.gitignore).
# Mots de passe : 16 caracteres ou plus, generes au hasard.

# --- API France Travail (francetravail.io) ---
FRANCE_TRAVAIL_CLIENT_ID=a_remplacer
FRANCE_TRAVAIL_CLIENT_SECRET=a_remplacer

# --- Entrepot PostgreSQL : compte proprietaire (pipeline, dbt) ---
DWH_DB=dwh
DWH_USER=a_remplacer
DWH_PASSWORD=a_remplacer

# --- Entrepot : compte de l'application, LECTURE SEULE ---
APP_DWH_USER=app_lecture
APP_DWH_PASSWORD=a_remplacer

# --- MinIO : compte administrateur (console, creation des comptes) ---
MINIO_ROOT_USER=a_remplacer
MINIO_ROOT_PASSWORD=a_remplacer

# --- MinIO : compte du pipeline, limite a raw et silver, sans suppression ---
MINIO_PIPELINE_USER=pipeline
MINIO_PIPELINE_PASSWORD=a_remplacer

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=a_remplacer
AIRFLOW_ADMIN_PASSWORD=a_remplacer
# Chiffre les connexions et variables stockees par Airflow. Generer avec :
#   docker compose exec airflow-scheduler python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Signe les sessions de l'interface web. Generer avec :
#   docker compose exec airflow-scheduler python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
