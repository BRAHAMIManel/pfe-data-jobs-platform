{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListerLesBucketsDuPipeline",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::raw", "arn:aws:s3:::silver"]
    },
    {
      "Sid": "LireEtEcrireRawEtSilver",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::raw/*", "arn:aws:s3:::silver/*"]
    }
  ]
}
